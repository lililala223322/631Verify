					</xs:annotation>
				</xs:attribute>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="PortTypePar">
		<xs:attribute name="Name" type="PortNameType" use="required">
			<xs:annotation>
				<xs:documentation>The name of the port.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="Direction" type="PortDirectionType" use="required">
			<xs:annotation>
				<xs:documentation>Defines whether the port is acting as a Source of data or a Destination.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="Attribute" type="PortAttributeTypePar" use="optional">
			<xs:annotation>
				<xs:documentation>Attibute used to specify the port type</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="DriverName" type="DriverNameType" use="required">
			<xs:annotation>
				<xs:documentation>String Name of the driver used by the pseudo-port</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>
	<xs:complexType name="PortTypeApp">
		<xs:attribute name="Name" type="PortNameType" use="required">
			<xs:annotation>
				<xs:documentation>The name of the port.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="Direction" type="PortDirectionType" use="required">
			<xs:annotation>
				<xs:documentation>Defines whether the port is acting as a Source of data or a Destination.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="Attribute" type="PortAttributeTypeApp" use="optional">
			<xs:annotation>
				<xs:documentation>Attibute used to specify the port type</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>
	<xs:complexType name="PortsTypePar">
		<!-- TR_PR_016: maxOccurs is "unbounded" (not 5120) because a finite value above
		     5000 exceeds the JDK Xerces content-model node limit and makes ALL schemas
		     fail to compile (schema becomes null and even valid files falsely report
		     error 1018). The sum limit of 5120 for QueuingPort+SamplingPort is enforced
		     by error 5016 (MiscellaneousConstraintValidator) per requirement 006379. -->
		<xs:choice minOccurs="0" maxOccurs="unbounded">
			<xs:element name="QueuingPort" type="QueuingPortTypePar"/>
			<xs:element name="SamplingPort" type="SamplingPortTypePar"/>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="PortsTypeApp">
		<xs:choice minOccurs="0" maxOccurs="unbounded">
			<xs:element name="QueuingPort" type="QueuingPortTypeApp"/>
			<xs:element name="SamplingPort" type="SamplingPortTypeApp"/>
		</xs:choice>
	</xs:complexType>

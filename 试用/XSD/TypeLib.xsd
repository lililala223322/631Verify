<?xml version="1.0" encoding="US-ASCII"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="http://www.actri.avic/ConfigRecord" xmlns:vp="http://www.actri.avic/XMLSchema/VP/1.0" targetNamespace="http://www.actri.avic/ConfigRecord" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:simpleType name="DecOrHexValueType">
		<xs:restriction base="xs:string">
			<xs:pattern value="[+\-]{0,1}[0-9]+|[+\-]{0,1}0x[0-9a-fA-F]+"/>
		</xs:restriction>
	</xs:simpleType>
	<!-- 004850: bounded decimal and hexadecimal integer types. -->
	<xs:simpleType name="UnsignedIntValueType">
		<xs:union>
			<xs:simpleType>
				<xs:restriction base="xs:unsignedInt"/>
			</xs:simpleType>
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:pattern value="0[xX][0-9a-fA-F]{1,8}"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:union>
	</xs:simpleType>
	<xs:simpleType name="UnsignedLongValueType">
		<xs:union>
			<xs:simpleType>
				<xs:restriction base="xs:unsignedLong"/>
			</xs:simpleType>
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:pattern value="0[xX][0-9a-fA-F]{1,16}"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:union>
	</xs:simpleType>
	<xs:simpleType name="UnsignedLongLongValueType">
		<xs:union>
			<xs:simpleType>
				<xs:restriction base="xs:unsignedLong"/>
			</xs:simpleType>
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:pattern value="0[xX][0-9a-fA-F]{1,16}"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:union>
	</xs:simpleType>
	<xs:simpleType name="SignedIntValueType">
		<xs:union>
			<xs:simpleType>
				<xs:restriction base="xs:int"/>
			</xs:simpleType>
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:pattern value="0[xX]([0-9a-fA-F]{1,7}|[0-7][0-9a-fA-F]{7})"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:union>
	</xs:simpleType>
	<xs:simpleType name="SignedLongLongValueType">
		<xs:union>
			<xs:simpleType>
				<xs:restriction base="xs:long"/>
			</xs:simpleType>
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:pattern value="0[xX]([0-9a-fA-F]{1,15}|[0-7][0-9a-fA-F]{15})"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:union>
	</xs:simpleType>
	<xs:simpleType name="HexValueType">
		<xs:restriction base="xs:string">
			<xs:pattern value="0[xX][0-9a-fA-F]+"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="CRC32Type">
		<xs:restriction base="xs:string">
			<xs:pattern value="(0[xX][0-9A-Fa-f]{8})?"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="IdentifierValueType">
		<xs:restriction base="DecOrHexValueType"/>
	</xs:simpleType>
	<xs:simpleType name="ModuleIdType">
		<xs:union>
			<xs:simpleType>
				<xs:restriction base="xs:integer">
					<xs:minInclusive value="0"/>
					<xs:maxInclusive value="255"/>
				</xs:restriction>
			</xs:simpleType>
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:pattern value="0[xX][0-9a-fA-F]{1,2}"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:union>
	</xs:simpleType>
	<xs:simpleType name="PartitionIdentifierType">
		<xs:union>
			<xs:simpleType>
				<xs:restriction base="xs:integer">
					<xs:minInclusive value="1"/>
					<xs:maxInclusive value="255"/>
				</xs:restriction>
			</xs:simpleType>
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:pattern value="0[xX][0-9a-fA-F]{1,2}"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:union>
	</xs:simpleType>
	<xs:simpleType name="ScheduleIdentifierType">
		<xs:union>
			<xs:simpleType>
				<xs:restriction base="xs:integer">
					<xs:minInclusive value="0"/>
					<xs:maxInclusive value="255"/>
				</xs:restriction>
			</xs:simpleType>
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:pattern value="0[xX][0-9a-fA-F]{1,2}"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:union>
	</xs:simpleType>
	<xs:simpleType name="MaxMessageSizeType">
		<xs:union>
			<xs:simpleType>
				<xs:restriction base="xs:integer">
					<xs:minInclusive value="1"/>
					<xs:maxInclusive value="1048576"/>
				</xs:restriction>
			</xs:simpleType>
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:pattern value="0[xX][0-9a-fA-F]{1,5}|0[xX]100000"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:union>
	</xs:simpleType>
	<xs:simpleType name="MaxNbMessageType">
		<xs:union>
			<xs:simpleType>
				<xs:restriction base="xs:integer">
					<xs:minInclusive value="1"/>
					<xs:maxInclusive value="512"/>
				</xs:restriction>
			</xs:simpleType>
			<xs:simpleType>
				<xs:restriction base="xs:string">
				<xs:pattern value="0[xX]0*([1-9a-fA-F]|[1-9a-fA-F][0-9a-fA-F]|1[0-9a-fA-F]{2}|200)"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:union>
	</xs:simpleType>
	<xs:simpleType name="TimeValueType">
		<xs:restriction base="DecOrHexValueType"/>
	</xs:simpleType>
	<xs:simpleType name="PartitionWindowOffsetType">
		<xs:annotation>
			<xs:documentation>Partition Window Offset value range [0, 9223372036854775807] nanoseconds</xs:documentation>
		</xs:annotation>
		<xs:union>
			<xs:simpleType>
				<xs:restriction base="xs:long">
					<xs:minInclusive value="0"/>
					<xs:maxInclusive value="9223372036854775807"/>
				</xs:restriction>
			</xs:simpleType>
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:pattern value="0[xX][0-7][0-9a-fA-F]{0,15}"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:union>
	</xs:simpleType>
	<xs:simpleType name="PartitionWindowDurationType">
		<xs:annotation>
			<xs:documentation>Partition Window Duration value range [1, 9223372036854775807] nanoseconds</xs:documentation>
		</xs:annotation>
		<xs:union>
			<xs:simpleType>
				<xs:restriction base="xs:long">
					<xs:minInclusive value="1"/>
					<xs:maxInclusive value="9223372036854775807"/>
				</xs:restriction>
			</xs:simpleType>
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:pattern value="0[xX][0-7][0-9a-fA-F]{0,15}"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:union>
	</xs:simpleType>
	<xs:simpleType name="LogBookMaxMessageSizeType">
		<xs:union>
			<xs:simpleType>
				<xs:restriction base="xs:integer">
					<xs:minInclusive value="0"/>
					<xs:maxInclusive value="65536"/>
				</xs:restriction>
			</xs:simpleType>
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:pattern value="0[xX][0-9a-fA-F]{1,4}|0[xX]10000"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:union>
	</xs:simpleType>
	<xs:simpleType name="LogBookMaxNBType">
		<xs:union>
			<xs:simpleType>
				<xs:restriction base="xs:integer">
					<xs:minInclusive value="1"/>
					<xs:maxInclusive value="2048"/>
				</xs:restriction>
			</xs:simpleType>
			<xs:simpleType>
				<xs:restriction base="xs:string">
				<xs:pattern value="0[xX]0*([1-9a-fA-F]|[1-9a-fA-F][0-9a-fA-F]{1,2}|[1-7][0-9a-fA-F]{3}|800)"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:union>
	</xs:simpleType>
	<xs:simpleType name="StackSizeType">
		<xs:union>
			<xs:simpleType>
				<xs:restriction base="xs:integer">
					<xs:minInclusive value="6144"/>
					<xs:maxInclusive value="4294963200"/>
				</xs:restriction>
			</xs:simpleType>
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:pattern value="0[xX][1-9a-eA-E][0-9a-fA-F]{3,7}|0[xX][fF]{1,3}[0-9a-eA-E][0-9a-fA-F]{3}|0[xX][fF]{4}[0-9a-eA-E][0-9a-fA-F]{3}"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:union>
	</xs:simpleType>
	<xs:simpleType name="SetAffinityPermissionType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="NOT_PERMITTED"/>
			<xs:enumeration value="INIT_ONLY"/>
			<xs:enumeration value="ALL_MODES"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="DurationType">
		<xs:union memberTypes="PartitionWindowDurationType">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:enumeration value="INFINITE_TIME"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:union>
	</xs:simpleType>
	<xs:simpleType name="partType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="PARTITION_APEX"/>
			<xs:enumeration value="PARTITION_POSIX"/>
			<xs:enumeration value="PARTITION_GOS"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="partitionMcoreModeType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="PARTITION_MP_BMP"/>
			<xs:enumeration value="PARTITION_MP_GSMP"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="determinSupportType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="PARTITION_DETERM_NONE"/>
			<xs:enumeration value="PARTITION_DETERM_CACHE_DYE"/>
			<xs:enumeration value="PARTITION_DETERM_MEM_BANK"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="GuestOsTypeValue">
		<xs:restriction base="xs:string">
			<xs:enumeration value="GOS_TYPE_ACOREOS"/>
			<xs:enumeration value="GOS_TYPE_ACOREOS653"/>
			<xs:enumeration value="GOS_TYPE_LINUX"/>
			<xs:enumeration value="GOS_TYPE_ACOREOSMP"/>
			<xs:enumeration value="GOS_TYPE_ACOREOS653MP"/>
			<xs:enumeration value="GOS_TYPE_BARE_METAL"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="DebugExceptType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="GOS_DEBUG_TRAP_DIRECTOR"/>
			<xs:enumeration value="GOS_DEBUG_TRAP_CORE_ROUTE"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="BitModeType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="PARTITION_BIT_MODE_32BIT"/>
			<xs:enumeration value="PARTITION_BIT_MODE_64BIT"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="InterruptModeType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="GOS_INTMODE_DIRECTOR"/>
			<xs:enumeration value="GOS_INTMODE_CORE_ROUTE"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="PayloadTypeValue">
		<xs:restriction base="xs:string">
			<xs:enumeration value="ROM_PAYLOAD_FS"/>
			<xs:enumeration value="ROM_PAYLOAD_MEM"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="FileTypeValue">
		<xs:restriction base="xs:string">
			<xs:enumeration value="ROM_PAYLOAD_LOAD_FILE"/>
			<xs:enumeration value="ROM_PAYLOAD_LOAD_BINARY"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="QueuingPortTypePar" mixed="true">
		<xs:complexContent mixed="true">
			<xs:extension base="A653P2_SAPPortType">
				<xs:attribute name="Attribute" type="PortAttributeTypePar" use="optional">
					<xs:annotation>
						<xs:documentation>Attibute used to specify the port type</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="DriverName" type="DriverNameType" use="required">
					<xs:annotation>
						<xs:documentation>String Name of the driver used by the pseudo-port</xs:documentation>
					</xs:annotation>
				</xs:attribute>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SamplingPortTypePar" mixed="true">
		<xs:complexContent mixed="true">
			<xs:extension base="A653_SamplingPortType">
				<xs:attribute name="Attribute" type="PortAttributeTypePar" use="optional">
					<xs:annotation>
						<xs:documentation>Attibute used to specify the port type</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="RefreshRate" type="DurationType" use="required">
					<xs:annotation>
						<xs:documentation>The expected refresh rate for the port.</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="DriverName" type="DriverNameType" use="required">
					<xs:annotation>
						<xs:documentation>String Name of the driver used by the pseudo-port</xs:documentation>
					</xs:annotation>
				</xs:attribute>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="A653P2_SAPPortType">
		<xs:annotation>
			<xs:documentation>The configurable attributes of SAP ports.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="A653_QueuingPortType">
				<xs:attribute name="ExtendedPort" type="booleanType" use="optional" default="false">
					<xs:annotation>
						<xs:documentation>If true, then the port supports extended services</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="ProtocolType" type="ProtocolTypeEnum" use="required">
					<xs:annotation>
						<xs:documentation>Type of transport protocol supported by the port.</xs:documentation>
					</xs:annotation>
				</xs:attribute>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="A653_QueuingPortType">
		<xs:annotation>
			<xs:documentation>ARINC 653 Queuing Port Type </xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="PortBaseType">
				<xs:attribute name="MaxNbMessage" type="MaxNbMessageType" use="required">
					<xs:annotation>
						<xs:documentation>The maximum number of messages for the
port.</xs:documentation>
					</xs:annotation>
				</xs:attribute>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="A653_SamplingPortType">
		<xs:annotation>
			<xs:documentation>ARINC 653 Sampling Port Type</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="PortBaseType"/>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="PortBaseType">
		<xs:annotation>
			<xs:documentation>ARINC 653 Base Port Type</xs:documentation>
		</xs:annotation>
		<xs:attribute name="Name" type="NameType" use="required">
			<xs:annotation>
				<xs:documentation>The name of the port.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="MaxMessageSize" type="MaxMessageSizeType" use="required">
			<xs:annotation>
				<xs:documentation>The maximum message size for the port in bytes.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="Direction" type="PortDirectionType" use="required">
			<xs:annotation>
				<xs:documentation>Defines if the port is a Source of data or a
Destination.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>
	<xs:complexType name="QueuingPortTypeApp" mixed="true">
		<xs:complexContent mixed="true">
			<xs:extension base="A653P2_SAPPortType">
				<xs:attribute name="Attribute" type="PortAttributeTypeApp" use="optional">
					<xs:annotation>
						<xs:documentation>Attibute used to specify the port type</xs:documentation>
